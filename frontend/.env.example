# Copie para .env e ajuste. Aqui só entra o que é PÚBLICO:
# tudo que começa com VITE_ vai parar no JavaScript que o navegador baixa.

# false = usa a API em C# (Excursoes.Api)
# true  = dados simulados no navegador (não precisa do back-end)
VITE_USE_MOCK=false

# Endereço da API (veja Properties/launchSettings.json do back)
VITE_API_URL=http://localhost:5002/api
