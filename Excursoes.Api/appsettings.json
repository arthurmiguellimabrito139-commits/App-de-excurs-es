{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "//": "NUNCA coloque senhas ou chaves aqui. Use user-secrets (desenvolvimento) ou variáveis de ambiente (produção).",

  "Jwt": {
    "Emissor": "Excursoes.Api",
    "Audiencia": "Excursoes.Front",
    "ExpiracaoMinutos": 60
  },

  "Cors": {
    "OrigensPermitidas": [ "http://localhost:5173" ]
  },

  "Seguranca": {
    "LimiteLoginPorMinuto": 5,
    "LimiteGeralPorMinuto": 300,
    "BcryptCusto": 12
  },

  "Uploads": {
    "TamanhoMaximoMb": 5
  },

  "Pagamentos": {
    "PermitirPagamentoSimulado": true
  }
}
