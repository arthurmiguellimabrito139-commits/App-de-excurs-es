<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>excursoes-api-6f1c2b7e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- SQL puro: o Dapper só transforma o resultado da consulta em objeto -->
    <PackageReference Include="Dapper" Version="2.1.66" />
    <!-- Driver do MySQL -->
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <!-- Hash de senha -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <!-- Validação do token JWT -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Os testes podem usar os métodos "internal" dos models (ex.: DefinirId) -->
    <InternalsVisibleTo Include="Excursoes.Tests" />
  </ItemGroup>

</Project>
